# Copiá este archivo a .env y ajustá los valores
# cp .env.example .env

# SQLite — sin instalar nada, perfecto para desarrollo local
DATABASE_URL=sqlite:///./crm_dev.db

# PostgreSQL — para producción
# DATABASE_URL=postgresql://user:password@localhost:5432/crm_db

# MS SQL Server — para clientes con infra Microsoft
# DATABASE_URL=mssql+pyodbc://user:pass@host/db?driver=ODBC+Driver+17+for+SQL+Server

APP_NAME=Mutare CRM
DEBUG=true
